#!/usr/bin/env bash
# Installed to .git/hooks/pre-commit by scripts/install-hooks.sh.
#
# Agents forget the style rules. This does not. It runs against the index, so
# what gets checked is exactly what is about to be committed, not whatever
# happens to be sitting in the working tree.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

python=python3
if [ -x .venv/bin/python ]; then
  python=.venv/bin/python
fi

# The venv's ruff, or none. `command -v ruff` was wrong twice over on a machine
# following the README, which says uv and nothing else: uv sync puts ruff in
# .venv/bin and not on PATH, so the hook skipped it in silence and let three
# ruff errors through, and where PATH did have one it was an unrelated 0.12.0
# against the 0.16.4 this project pins. Two lines above already resolved python
# this way.
ruff=""
if [ -x .venv/bin/ruff ]; then
  ruff=.venv/bin/ruff
elif command -v ruff >/dev/null 2>&1; then
  ruff=$(command -v ruff)
fi

echo "pre-commit: fingerprint check"
if ! "$python" scripts/check_fingerprint.py --staged; then
  cat >&2 <<'MSG'

Commit blocked. Fix the hits above.

If one is genuinely wrong, add the ignore marker to that line, or add a new
entry to the allowed-contexts block in BANNED.md when the false positive will
keep recurring. Do not disable the hook.
MSG
  exit 1
fi

# Ruff is cheap and catches the dead imports that pile up during a slice.
staged_py=$(git diff --cached --name-only --diff-filter=ACM -- '*.py')
if [ -n "$staged_py" ]; then
  if [ -z "$ruff" ]; then
    cat >&2 <<'MSG'

Commit blocked: no ruff. Run `uv sync --all-extras`.

Skipping it quietly was the old behaviour and it let a commit through with
three lint errors in it, which is worse than refusing.
MSG
    exit 1
  fi
  echo "pre-commit: ruff ($("$ruff" --version))"
  echo "$staged_py" | xargs "$ruff" check
fi

echo "pre-commit: ok"
